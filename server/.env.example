DATABASE_URL=postgresql://user:password@localhost:5432/spiko
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=3000
NODE_ENV=development

# Optional. Leave these commented out rather than empty: an empty string is
# treated as a value, not as "unset".
# DIRECT_URL=postgresql://user:password@localhost:5432/spiko
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# COOKIE_SAMESITE=lax        # lax | strict | none
# TRUST_PROXY=1              # reverse-proxy hops in front of the app (real client IPs for rate limiting)
